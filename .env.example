# Copy this file to .env and adjust. Never commit your real .env.
# No credentials are required -- providers below are public, unauthenticated
# ATS job-board APIs (Greenhouse, Lever). Do not add scraping of sites that
# require login, CAPTCHA-bypass, or anti-bot evasion.

# Autonomous discovery loop on/off. Starts OFF by default -- turn on only when
# you're ready for the background loop to fetch/analyze jobs on a timer.
AGENT_ENABLED=false

# How often the background loop runs a discovery cycle.
DISCOVERY_INTERVAL_MINUTES=15

# Safety caps per discovery cycle.
MAX_JOBS_PER_CYCLE=25

# Jobs below this technical-match score (0-100) are marked SKIPPED_POOR_MATCH.
MIN_MATCH_SCORE=25

# Discard postings older than this many days at discovery time.
FRESHNESS_MAX_DAYS=3

# Comma-separated list of provider names to enable.
ENABLED_PROVIDERS=greenhouse,lever

# Comma-separated Greenhouse board tokens (the "token" in
# boards-api.greenhouse.io/v1/boards/<token>/jobs). Example only -- verify it
# is still a valid public board before relying on it.
GREENHOUSE_BOARD_TOKENS=gitlab

# Comma-separated Lever company slugs (api.lever.co/v0/postings/<slug>).
# "leverdemo" is Lever's own public demo/example account.
LEVER_COMPANY_SLUGS=leverdemo

# Reject a job only when a published MAXIMUM salary is below this; never
# reject solely because salary isn't published.
MIN_SALARY_USD=80000

# --- Phase 3: additional ATS connectors -------------------------------------
# Each is a comma-separated list of tenant identifiers for that provider.
# Empty by default -- a provider only fetches anything once you both add it to
# ENABLED_PROVIDERS above AND give it at least one tenant identifier here.
# See docs/provider-capabilities.md for what each provider actually supports.
ASHBY_JOB_BOARD_NAMES=
WORKABLE_ACCOUNT_SUBDOMAINS=
SMARTRECRUITERS_COMPANY_IDS=
BAMBOOHR_SUBDOMAINS=
RECRUITEE_SUBDOMAINS=
BREEZY_SUBDOMAINS=
TEAMTAILOR_SUBDOMAINS=
# Comeet requires the public embed token shown on the company's own careers
# page (not a secret) -- format is "company:token" pairs, comma-separated.
COMEET_COMPANY_TOKENS=
# Workday tenants vary too much to guess a URL -- each entry is the tenant's
# FULL base URL, e.g. https://acme.wd5.myworkdayjobs.com/wday/cxs/acme/External
WORKDAY_TENANT_BASE_URLS=

# --- Phase 3: provider HTTP hardening / pagination safety / scheduling ------
PROVIDER_HTTP_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_RESPONSE_BYTES=5000000
PROVIDER_CONCURRENCY_LIMIT=5
PROVIDER_USER_AGENT=SponsorJobAgent/1.0 (+local job-discovery agent; contact=candidate; respects robots/ToS)

MAX_PAGES_PER_PROVIDER=20
MAX_JOBS_PER_PROVIDER=500

PROVIDER_DEFAULT_POLL_MINUTES=15
PROVIDER_MIN_POLL_MINUTES=10
PROVIDER_MAX_POLL_MINUTES=240

# Seed a handful of illustrative demo entries into the company_registry table
# on first init. Off by default -- populate the registry deliberately.
REGISTRY_SEED_DEMO_DATA=false

# --- Phase 4: registry acquisition/verification/lifecycle scale settings ---
# Deterministic partitioning for a future distributed worker (Phase 7). Local
# default is 1 shard / index 0 -- change only when running multiple workers.
REGISTRY_SHARD_COUNT=1
REGISTRY_SHARD_INDEX=0

# Backpressure bounds for one local registry verification/poll cycle -- never
# "poll everything at once" regardless of registry size.
REGISTRY_DUE_BATCH_SIZE=50
DISCOVERY_CYCLE_TIME_BUDGET_SECONDS=60
REGISTRY_MAX_PORTALS_PER_CYCLE=50

# How many jobs to request when the verification pipeline probes a candidate
# portal's endpoint (a structural check, not a real poll).
REGISTRY_VERIFICATION_PROBE_JOBS=5
# Consecutive PERMANENT (e.g. repeated 404) failures before an ACTIVE/VERIFIED
# portal is demoted to STALE. Transient failures (timeout/429/5xx) never count
# toward this.
REGISTRY_STALE_AFTER_PERMANENT_FAILURES=5

# --- Phase 4: safe bounded career-page discovery ---------------------------
PAGE_DISCOVERY_MAX_PAGES=9
PAGE_DISCOVERY_TIMEOUT_SECONDS=8
PAGE_DISCOVERY_MAX_RESPONSE_BYTES=2000000
PAGE_DISCOVERY_MAX_REDIRECTS=3
PAGE_DISCOVERY_CONCURRENCY_LIMIT=3
PAGE_DISCOVERY_RESPECT_ROBOTS=true

# --- Phase 5: distributed polling execution layer ---------------------------
# All local-mode by default -- SQLite-backed, no external services required.
# See docs/phase5-distributed-polling.md / docs/worker-architecture.md /
# docs/polling-leases.md / docs/fleet-operations.md.

# How many portals one worker process attempts concurrently.
POLL_WORKER_CONCURRENCY=4
# How long a worker owns a leased portal before another worker may reclaim
# it (protects against a crashed/hung worker permanently locking work).
PORTAL_LEASE_SECONDS=120
# How often a running worker updates its heartbeat row.
WORKER_HEARTBEAT_SECONDS=15

# How many due work items one claim call pulls into memory at once, per
# queue, per worker cycle -- bounded regardless of registry size.
DUE_WORK_BATCH_SIZE=50
# Wall-clock budget for one worker cycle (claim -> process -> repeat) before
# it stops claiming new work and loops back to housekeeping/sleep.
POLL_CYCLE_TIME_BUDGET_SECONDS=60
# Hard cap on portals processed by one worker in one cycle.
MAX_PORTALS_PER_WORKER_CYCLE=50

# Max concurrent in-flight requests to one provider, enforced across ALL
# worker processes sharing this database.
PROVIDER_CONCURRENCY_DEFAULT=3

# After this many CONSECUTIVE PERMANENT (non-transient) failures, a work
# item is disabled and recorded in the dead-letter table instead of being
# retried forever.
DEAD_LETTER_MAX_ATTEMPTS=8

# Circuit breaker: failure-rate fraction (0.0-1.0, once a minimum sample is
# observed) that trips a provider's polling fleet-wide, and how long it
# stays paused before a single low-frequency probe is allowed through.
CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
CIRCUIT_BREAKER_COOLDOWN_SECONDS=120

# Bounded grace period for in-flight work to finish after SIGINT/SIGTERM.
WORKER_SHUTDOWN_GRACE_SECONDS=20

# Bounded worker count for the local dev supervisor (app/workers/supervisor.py).
SUPERVISOR_MAX_WORKERS=8

# --- Phase 6: production-scale distributed architecture ---------------------
# See docs/phase6-production-scale.md, docs/postgres-backend.md,
# docs/distributed-workers.md, docs/deployment-postgres.md.

# Database backend. Leave unset (or "sqlite:///path") for the default local
# SQLite file at data/app.db -- nothing else needs to change. Set to a real
# "postgresql://user:password@host:port/dbname" to run against a shared
# PostgreSQL instance instead (required for genuine multi-machine workers).
# NEVER commit a real value with real credentials -- this .env.example
# intentionally leaves it blank.
DATABASE_URL=

# Orphan worker reaper: a worker is marked OFFLINE (not the same as its
# leases being reclaimed, which happens independently via lease expiry) only
# after its heartbeat is this many seconds stale.
ORPHAN_WORKER_STALE_SECONDS=90

# Bounded statement timeout for Postgres connections (milliseconds) -- a
# hung query must never wedge a worker or the dashboard forever.
POSTGRES_STATEMENT_TIMEOUT_MS=30000

# Prometheus-format /metrics endpoint. On by default; never exposes
# candidate PII.
METRICS_ENABLED=true

# Schema drift affecting this many DISTINCT tenants of the same provider
# within the window below is treated as provider-wide and feeds the
# existing circuit breaker -- one oddball tenant never trips it alone.
SCHEMA_DRIFT_CIRCUIT_TENANT_THRESHOLD=3
SCHEMA_DRIFT_WINDOW_HOURS=1.0

# Structured JSON logging. Off by default (plain text is easier to read in a
# local terminal) -- turn on for production deployments with a log
# aggregator that expects JSON lines.
STRUCTURED_LOGGING_ENABLED=false

# --- Phase 8: safe ATS application executor ---------------------------------
# See docs/phase8-application-executor.md, docs/application-safety.md.
# BOTH default to false -- discovery/analysis/resume generation are never
# gated by these two flags; only queuing/executing/submitting applications is.

# Master on/off switch for the application executor (queuing/preparing
# applications at all). Discovery keeps running regardless of this setting.
APPLICATION_EXECUTOR_ENABLED=false

# Whether AUTO_PERMITTED mode is allowed to actually submit anything. Even
# when true, a specific application only auto-submits if EVERY condition in
# CLAUDE.md Phase 8 section 45 is met (FULL_TIME, CONFIRMED_SPONSOR, claim
# check passed, provider policy PERMITTED_AUTO, no CAPTCHA/MFA, no unresolved
# legal/demographic question, no duplicate, rate limits not exceeded).
AUTO_SUBMIT_ENABLED=false

# Minimum technical match score (0-100) required to enter the application
# executor queue -- distinct from (and may be stricter than) MIN_MATCH_SCORE,
# which only gates resume generation. Defaults to the same value.
MIN_APPLICATION_MATCH_SCORE=25

# Safe application-volume defaults (CLAUDE.md Phase 8 sections 46-47) -- never
# spray-and-pray. Enforced via a live DB query against application_audit_log,
# already fleet-wide the moment DATABASE_URL points at shared Postgres.
MAX_APPLICATIONS_PER_HOUR=5
MAX_APPLICATIONS_PER_DAY=20
MAX_APPLICATIONS_PER_COMPANY_PER_DAY=2

# How long an application-execution lease is held before another
# executor-capable worker may reclaim it, and how many executions one worker
# processes concurrently.
APPLICATION_LEASE_SECONDS=300
APPLICATION_WORKER_CONCURRENCY=2

# ANALYZE / ASSIST / AUTO_PERMITTED. ASSIST remains the default -- there is
# no "force auto-submit" mode.
APPLICATION_DEFAULT_MODE=ASSIST

# --- Phase 9: production application-worker fleet ---------------------------
# See docs/phase9-production-application-workers.md,
# docs/application-worker-architecture.md, docs/application-reconciliation.md,
# docs/application-browser-assist.md, docs/application-provider-capabilities.md.
# Every flag below defaults to false/off/conservative -- none of it changes
# APPLICATION_EXECUTOR_ENABLED/AUTO_SUBMIT_ENABLED above.

# Whether the continuous scheduler (app.applications.scheduler) auto-queues
# eligible READY_TO_APPLY jobs at all. Independent of AUTO_SUBMIT_ENABLED
# (CLAUDE.md Phase 9 section 37): a job is only ever queued in AUTO_PERMITTED
# mode when BOTH this AND AUTO_SUBMIT_ENABLED are true AND that specific job
# already clears every eligibility check.
APPLICATION_AUTO_PREPARE_ENABLED=false
APPLICATION_SCHEDULER_MAX_QUEUE_PER_CYCLE=5
APPLICATION_SCHEDULER_CYCLE_SECONDS=300

# Application worker daemon (python -m app.applications.worker run) --
# deliberately far more conservative than the Phase 5 discovery-worker
# settings, since application submission is rare, high-consequence, and
# rate-limited (never "spray and pray").
APPLICATION_WORKER_HEARTBEAT_SECONDS=15
APPLICATION_WORKER_IDLE_SLEEP_SECONDS=10
APPLICATION_WORKER_CYCLE_TIME_BUDGET_SECONDS=60
APPLICATION_MAX_EXECUTIONS_PER_WORKER_CYCLE=5
APPLICATION_WORKER_SHUTDOWN_GRACE_SECONDS=30
APPLICATION_SUPERVISOR_MAX_WORKERS=4
APPLICATION_SKIP_COOLDOWN_SECONDS=10

# Per-provider submission concurrency -- a real in-flight submission is a
# consequential, rate-limited action, never treated like a cheap discovery GET.
APPLICATION_PROVIDER_CONCURRENCY_DEFAULT=1

# Submission circuit breaker (app.applications.circuit) -- a SEPARATE
# breaker/table from the discovery circuit breaker above, tripped far more
# conservatively (fewer consecutive failures, longer cooldown).
APPLICATION_CIRCUIT_BREAKER_FAILURE_THRESHOLD=0.5
APPLICATION_CIRCUIT_BREAKER_COOLDOWN_SECONDS=300
APPLICATION_CIRCUIT_CONSECUTIVE_TRIP_THRESHOLD=3

# CONSECUTIVE PERMANENT (never transient) submission failures for a job
# before the application-side dead-letter reporting flags it.
APPLICATION_DEAD_LETTER_MAX_ATTEMPTS=3

# Automated reconciliation EVIDENCE pass (app.applications.reconcile_worker)
# for SUBMISSION_STATUS_UNKNOWN executions. Off by default. It never itself
# fabricates a confirmation -- it only calls a provider's OPTIONAL, genuinely
# legitimate check_submission_status() hook (none of the real ATS adapters in
# this project implement one; only the deterministic mock ATS does, to prove
# the mechanism) and always funnels any result through the same
# reconcile_execution() a human operator would use.
RECONCILE_WORKER_ENABLED=false
RECONCILE_WORKER_INTERVAL_SECONDS=900

# Browser-assist (CLAUDE.md Phase 9 sections 21-22) -- optional, visible-
# browser-only preparation aid. Requires `pip install playwright` AND
# `playwright install chromium` separately; never a default/implicit
# dependency. No stealth/fingerprint-spoofing/CAPTCHA-solving/proxy-rotation/
# anti-bot-bypass/hidden-login/MFA-interception is ever performed, and no
# password/MFA-code/cookie/token is ever persisted -- every browser context
# is fresh and ephemeral, closed at the end of every call.
BROWSER_ASSIST_ENABLED=false
BROWSER_ASSIST_HEADLESS=false
BROWSER_ASSIST_TIMEOUT_SECONDS=30

# --- Phase 10: production-quality real-ATS browser assist -------------------
# See docs/phase10-real-ats-assist.md, docs/browser-assist-sessions.md,
# docs/real-ats-validation.md. Extends (never replaces) the Phase 9 flags
# above -- BROWSER_ASSIST_ENABLED must still be true for any of this to run.

# Phase 10 name for the same concept as BROWSER_ASSIST_HEADLESS above --
# whichever is set wins (BROWSER_HEADLESS takes precedence if both are set).
# Real application assist should normally run VISIBLE (false) so the
# candidate can see and take over for login/CAPTCHA/final submit.
BROWSER_HEADLESS=false

# Browser sessions are expensive and interactive -- bounded, conservative
# concurrency. Never treated like discovery's multi-worker-per-provider
# concurrency.
BROWSER_ASSIST_CONCURRENCY=1

# A session with no activity for this long is reaped as EXPIRED by the
# scheduled background reaper (never auto-submits or deletes evidence --
# only flips status so a fresh attempt can start cleanly).
BROWSER_SESSION_TIMEOUT_MINUTES=30

# Same runtime scratch directory as BROWSER_ASSIST_PROFILE_DIR (never
# committed -- see .gitignore) under a Phase 10 name. Leave blank to use the
# existing default (data/browser_assist_runtime).
BROWSER_RUNTIME_DIR=

# How long a claimed browser-assist session lease is held before another
# worker/dashboard action may reclaim it -- same lease-expiry-only recovery
# model as every other queue in this project.
BROWSER_SESSION_LEASE_SECONDS=600

# Automated evidence-gathering pass for SUBMISSION_STATUS_UNKNOWN
# executions (app.applications.reconcile_worker) now actually runs on this
# schedule in the background (Phase 9 defined these two flags but nothing
# ever read them until Phase 10's app.applications.background_scheduler).
# It never itself fabricates a confirmation -- see RECONCILE_WORKER_ENABLED
# above in the Phase 9 section.

# =============================================================================
# Phase 14: resume optimizer / unified dashboard
# =============================================================================

# Whether jobs are queued for background resume optimization automatically
# (app.resume_optimizer.scheduler). False by default -- the dashboard
# "Generate/Regenerate Resume" action and `python -m app.resume_optimizer.cli
# generate` always work regardless of this flag; it only controls whether
# eligible jobs (sponsorship-eligible, no current READY variant) get
# optimized automatically in the background.
RESUME_OPTIMIZATION_ENABLED=false
RESUME_OPTIMIZATION_INTERVAL_SECONDS=300
RESUME_OPTIMIZATION_BATCH_SIZE=5
