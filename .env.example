# Copy this file to .env and adjust. Never commit your real .env.
# No credentials are required -- providers below are public, unauthenticated
# ATS job-board APIs (Greenhouse, Lever). Do not add scraping of sites that
# require login, CAPTCHA-bypass, or anti-bot evasion.

# Autonomous discovery loop on/off. Starts OFF by default -- turn on only when
# you're ready for the background loop to fetch/analyze jobs on a timer.
AGENT_ENABLED=false

# How often the background loop runs a discovery cycle.
DISCOVERY_INTERVAL_MINUTES=15

# Safety caps per discovery cycle.
MAX_JOBS_PER_CYCLE=25

# Jobs below this technical-match score (0-100) are marked SKIPPED_POOR_MATCH.
MIN_MATCH_SCORE=25

# Discard postings older than this many days at discovery time.
FRESHNESS_MAX_DAYS=3

# Comma-separated list of provider names to enable.
ENABLED_PROVIDERS=greenhouse,lever

# Comma-separated Greenhouse board tokens (the "token" in
# boards-api.greenhouse.io/v1/boards/<token>/jobs). Example only -- verify it
# is still a valid public board before relying on it.
GREENHOUSE_BOARD_TOKENS=gitlab

# Comma-separated Lever company slugs (api.lever.co/v0/postings/<slug>).
# "leverdemo" is Lever's own public demo/example account.
LEVER_COMPANY_SLUGS=leverdemo

# Reject a job only when a published MAXIMUM salary is below this; never
# reject solely because salary isn't published.
MIN_SALARY_USD=80000
