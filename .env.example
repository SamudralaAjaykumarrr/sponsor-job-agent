# Copy this file to .env and adjust. Never commit your real .env.
# No credentials are required -- providers below are public, unauthenticated
# ATS job-board APIs (Greenhouse, Lever). Do not add scraping of sites that
# require login, CAPTCHA-bypass, or anti-bot evasion.

# Autonomous discovery loop on/off. Starts OFF by default -- turn on only when
# you're ready for the background loop to fetch/analyze jobs on a timer.
AGENT_ENABLED=false

# How often the background loop runs a discovery cycle.
DISCOVERY_INTERVAL_MINUTES=15

# Safety caps per discovery cycle.
MAX_JOBS_PER_CYCLE=25

# Jobs below this technical-match score (0-100) are marked SKIPPED_POOR_MATCH.
MIN_MATCH_SCORE=25

# Discard postings older than this many days at discovery time.
FRESHNESS_MAX_DAYS=3

# Comma-separated list of provider names to enable.
ENABLED_PROVIDERS=greenhouse,lever

# Comma-separated Greenhouse board tokens (the "token" in
# boards-api.greenhouse.io/v1/boards/<token>/jobs). Example only -- verify it
# is still a valid public board before relying on it.
GREENHOUSE_BOARD_TOKENS=gitlab

# Comma-separated Lever company slugs (api.lever.co/v0/postings/<slug>).
# "leverdemo" is Lever's own public demo/example account.
LEVER_COMPANY_SLUGS=leverdemo

# Reject a job only when a published MAXIMUM salary is below this; never
# reject solely because salary isn't published.
MIN_SALARY_USD=80000

# --- Phase 3: additional ATS connectors -------------------------------------
# Each is a comma-separated list of tenant identifiers for that provider.
# Empty by default -- a provider only fetches anything once you both add it to
# ENABLED_PROVIDERS above AND give it at least one tenant identifier here.
# See docs/provider-capabilities.md for what each provider actually supports.
ASHBY_JOB_BOARD_NAMES=
WORKABLE_ACCOUNT_SUBDOMAINS=
SMARTRECRUITERS_COMPANY_IDS=
BAMBOOHR_SUBDOMAINS=
RECRUITEE_SUBDOMAINS=
BREEZY_SUBDOMAINS=
TEAMTAILOR_SUBDOMAINS=
# Comeet requires the public embed token shown on the company's own careers
# page (not a secret) -- format is "company:token" pairs, comma-separated.
COMEET_COMPANY_TOKENS=
# Workday tenants vary too much to guess a URL -- each entry is the tenant's
# FULL base URL, e.g. https://acme.wd5.myworkdayjobs.com/wday/cxs/acme/External
WORKDAY_TENANT_BASE_URLS=

# --- Phase 3: provider HTTP hardening / pagination safety / scheduling ------
PROVIDER_HTTP_TIMEOUT_SECONDS=10
PROVIDER_MAX_RETRIES=2
PROVIDER_MAX_RESPONSE_BYTES=5000000
PROVIDER_CONCURRENCY_LIMIT=5
PROVIDER_USER_AGENT=SponsorJobAgent/1.0 (+local job-discovery agent; contact=candidate; respects robots/ToS)

MAX_PAGES_PER_PROVIDER=20
MAX_JOBS_PER_PROVIDER=500

PROVIDER_DEFAULT_POLL_MINUTES=15
PROVIDER_MIN_POLL_MINUTES=10
PROVIDER_MAX_POLL_MINUTES=240

# Seed a handful of illustrative demo entries into the company_registry table
# on first init. Off by default -- populate the registry deliberately.
REGISTRY_SEED_DEMO_DATA=false
